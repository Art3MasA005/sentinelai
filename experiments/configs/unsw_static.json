{
  "name": "UNSW-NB15 \u00b7 static",
  "dataset_id": "UNSW-NB15",
  "profile": "unswnb15",
  "seed": 42,
  "model": {
    "kind": "hist_gb"
  },
  "split": {
    "train_fraction": 0.3,
    "val_fraction": 0.2,
    "window_size": 4000,
    "max_rows": 400000
  },
  "openworld": {
    "method": "msp+centroid",
    "msp_quantile": 0.02,
    "distance_quantile": 0.99
  },
  "drift": {
    "detectors": [
      "ks",
      "psi",
      "confidence"
    ]
  },
  "labels": {
    "delay_windows": 1,
    "budget": 0.1
  },
  "adaptation": {
    "method": "static",
    "retrain_every": 5,
    "memory_windows": 5
  },
  "notes": "Real data: UNSW-NB15 raw CSVs UNSW-NB15_1..4.csv (UNSW Canberra, IXIA PerfectStorm; 22 Jan and 17-18 Feb 2015), 400k rows evenly sampled over time. Cite Moustafa & Slay, MilCIS 2015."
}